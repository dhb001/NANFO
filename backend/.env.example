# NANFO backend — local development environment (every Settings field is listed).
#
# scripts/dev-start.sh generates a private backend/.env (mode 0600) from this file
# only when none exists: it fills the four empty secrets with independent random
# values and forces APP_ENV=development. For manual setup: cp .env.example .env,
# chmod 600 .env, then fill ALL four secrets (stores >= 16 characters; JWT key
# >= 32 bytes with >= 10 distinct characters, e.g. `openssl rand -hex 32`).
# Empty secrets deliberately prevent Compose startup. Never commit .env.
#
# Rules for this file (enforced by backend/tests/unit/test_env_example.py):
# - Active `KEY=value` lines must be Settings fields: unknown keys in .env make
#   Settings refuse to start (extra inputs are forbidden).
# - Optional fields whose "unset" meaning differs from every value are shown
#   commented out (`# KEY=value`); an empty value would fail validation there.
# - Worker/maintenance processes also read NANFO_* process variables that are NOT
#   Settings fields; export them in that process's environment, never here:
#   stream retention (NANFO_STREAM_ARCHIVE_ROOT, NANFO_STREAM_RETENTION_*,
#   STREAM_RETENTION_REDIS_URL), telemetry retention/SLO (TELEMETRY_RETENTION_DSN,
#   NANFO_TELEMETRY_RETENTION_*, NANFO_TELEMETRY_SLO_*), SNMP collectors
#   (NANFO_SNMP_RUNTIME_DIR), lab command MACs (NANFO_LAB_COMMAND_KEY_FILE, C15),
#   receiver health receipts (NANFO_RECEIVER_HEALTH_*, C21) and the network asset store
#   (NETWORK_ASSET_ROOT, NETWORK_ASSET_MAX_OBJECT_BYTES, NETWORK_ASSET_MAX_TOTAL_BYTES,
#   NETWORK_ASSET_MAX_OBJECTS, NETWORK_ASSET_NETWORK_MAX_ACTIVE_BYTES,
#   NETWORK_ASSET_NETWORK_MAX_ACTIVE_ASSETS, NETWORK_ASSET_STALE_UPLOAD_SECONDS; read by
#   the network module's own AssetSettings from the process environment only).
# Values below are the application defaults unless marked as a development value.

# ── Application ──────────────────────────────────────────────────────────────
# Development value. The code default is `production` (fail closed); deployments
# must opt into local behaviour explicitly (development/dev/test/testing).
APP_ENV=development
# `worker` processes never issue or verify user tokens (no JWT key needed, C10).
NANFO_SERVICE_ROLE=api
# demo enables synthetic adapters; emulation/production require installed real adapters.
# Selecting a mode does not install a controller, evaluator, or report renderer.
EXECUTION_MODE=demo
LOG_LEVEL=INFO
# Comma-separated explicit browser origins for CORS ('*' and 'null' are rejected).
# Production gateways serve the UI same-origin (C16); this is for the Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OpenAPI/Swagger routes. Unset: enabled everywhere except APP_ENV production/prod.
# API_DOCS_ENABLED=true
# Request body bounds (C2): default routes and the asset upload route (bytes).
API_MAX_BODY_BYTES=1048576
API_MAX_ASSET_UPLOAD_BYTES=12582912
# PUT .../spatial-scene replaces a whole scene (<= 10,000 objects).
API_MAX_SPATIAL_SCENE_BYTES=8388608
# /ready result reuse (seconds, <= 2).
API_READINESS_CACHE_SECONDS=1.5
# Leader startup bounds (seconds); backfill never blocks readiness.
API_STARTUP_BACKFILL_TIMEOUT_SECONDS=300
API_STARTUP_GRAPH_SCHEMA_TIMEOUT_SECONDS=10
API_STARTUP_COLLECTOR_TIMEOUT_SECONDS=15
# After realtime lease loss: graceful SIGTERM, then hard exit after this many seconds.
API_REALTIME_LEASE_LOSS_EXIT_SECONDS=20

# ── PostgreSQL (backend/docker-compose.yml binds 127.0.0.1:5432) ────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=nanfo
POSTGRES_PASSWORD=
POSTGRES_DB=nanfo
# Per process pool: API + six workers x (5 + 5) = 70 < PostgreSQL max_connections 100.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
# 0 disables. Idle-in-transaction must exceed every bounded worker/handler timeout.
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=900000
DB_ECHO=false

# ── Neo4j (bolt on 127.0.0.1:7687; no APOC or unrestricted procedures) ──────
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_CONNECTION_ACQUISITION_TIMEOUT_SECONDS=10
NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=15
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ── Redis (127.0.0.1:6379, noeviction) ──────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# ACL user (C24). The dev Compose file defines this user with the production
# command set (+@all -@dangerous +info +client|setname +client|id) and applies the
# same restrictions to `default`, so clients that ignore the username still work.
# Empty/unset authenticates as `default`.
REDIS_USERNAME=nanfo
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_STREAM_MAX_CONNECTIONS=24
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
# Must exceed the 2 s XREADGROUP BLOCK interval used by domain consumers.
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_POOL_TIMEOUT_SECONDS=2

# ── Realtime fan-out (ADR010 singleton unless explicitly distributed) ────────
API_REALTIME_LEASE_TTL_SECONDS=30
API_REALTIME_DISTRIBUTED=false
API_REALTIME_FANOUT_MAX_ENTRIES=4096
API_REALTIME_FANOUT_MAX_PAYLOAD_BYTES=262144
API_REALTIME_FANOUT_BATCH_SIZE=32
API_REALTIME_FANOUT_DEDUP_ENTRIES=4096
API_REALTIME_FANOUT_HEARTBEAT_SECONDS=1
API_REALTIME_FANOUT_STALE_SECONDS=5
API_REALTIME_FANOUT_IO_TIMEOUT_SECONDS=2
API_REALTIME_FANOUT_RETRY_SECONDS=1
API_REALTIME_FANOUT_SHUTDOWN_SECONDS=5
# Must stay below API_REALTIME_FANOUT_STALE_SECONDS.
API_REALTIME_COLLECTOR_WATCHDOG_SECONDS=1

# ── Domain events (C14) ──────────────────────────────────────────────────────
EVENT_RECLAIM_IDLE_MS=60000
EVENT_CONSUMER_BATCH_SIZE=10
# Must cover EVENT_MAX_DELIVERIES x (EVENT_RECLAIM_IDLE_MS + EVENT_HANDLER_TIMEOUT_SECONDS).
EVENT_COMPLETION_TTL_SECONDS=3600
EVENT_HANDLER_TIMEOUT_SECONDS=30
EVENT_MAX_DELIVERIES=20
# Stable per instance. Unset: "<NANFO_SERVICE_ROLE>-<hostname>".
# EVENT_CONSUMER_NAME=api-dev-1
# 1 keeps strict per-stream ordering; >1 keeps order per network/device key only.
EVENT_CONSUMER_CONCURRENCY=1
# Producers refuse XADD at this share of Redis maxmemory.
EVENT_PUBLISH_MAX_MEMORY_RATIO=0.90

# ── WebSocket admission (C1) ─────────────────────────────────────────────────
WS_MAX_CONNECTIONS_PER_USER=16
WS_SUBSCRIBE_TIMEOUT_SECONDS=10
# Authorization cache per connection (seconds, <= 15, never beyond token expiry).
WS_AUTH_CACHE_SECONDS=15
WS_MAX_FRAME_BYTES=65536

# ── Workers ──────────────────────────────────────────────────────────────────
# Empty disables the heartbeat file for local commands; deployments supply a private path.
WORKER_HEARTBEAT_PATH=
WORKER_ITERATION_TIMEOUT_SECONDS=330
WORKER_HEARTBEAT_MAX_AGE_SECONDS=360

# ── Event-loop watchdog ──────────────────────────────────────────────────────
# A loop stalled longer than the timeout exits with code 70 so the restart policy
# replaces it. Unset: enabled except when APP_ENV is test/testing.
# WATCHDOG_ENABLED=true
WATCHDOG_TIMEOUT_SECONDS=120
WATCHDOG_HEARTBEAT_INTERVAL_SECONDS=5
WATCHDOG_CHECK_INTERVAL_SECONDS=5

# ── JWT (C10/C19) ────────────────────────────────────────────────────────────
# Required for the API role: >= 32 bytes, >= 10 distinct characters, no placeholder.
JWT_SECRET_KEY=
# Comma-separated verify-only keys accepted during rotation (same strength rules).
# JWT_PREVIOUS_SECRET_KEYS=<previous-key-1>,<previous-key-2>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Login throttling (C11) and sessions (C9) ─────────────────────────────────
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=43200
AUTH_REFRESH_GRACE_SECONDS=20

# ── Runtime telemetry adapter ────────────────────────────────────────────────
# Modes: stub, seeded, snmp (demo), grpc (demo), emulation (ADR-009 measured
# snapshot), measured_snmp (requires emulation/production mode and both paths below).
TELEMETRY_RUNTIME_ADAPTER_MODE=stub
# Independent fleet worker owns collection (requires the API adapter to be stub).
TELEMETRY_FLEET_ENABLED=false
# Absolute, distinct, operator-protected files for measured_snmp only.
# TELEMETRY_MEASURED_SNMP_BINDING_PATH=/etc/nanfo/snmp-binding.json
# TELEMETRY_MEASURED_SNMP_CREDENTIALS_PATH=/run/secrets/snmp_credentials.json
TELEMETRY_MEASURED_SNMP_POLL_INTERVAL_SECONDS=10
TELEMETRY_MEASURED_SNMP_POLL_TIMEOUT_SECONDS=60
TELEMETRY_RUNTIME_ADAPTER_SEEDED_SAMPLE_KEY=nanfo-runtime
TELEMETRY_RUNTIME_ADAPTER_SEEDED_METRIC=runtime_adapter_heartbeat
TELEMETRY_RUNTIME_ADAPTER_SEEDED_VALUE=1.0
TELEMETRY_RUNTIME_ADAPTER_SEEDED_UNIT=count
TELEMETRY_RUNTIME_ADAPTER_SEEDED_SOURCE=runtime_seeded
TELEMETRY_RUNTIME_ADAPTER_SNMP_TARGET=127.0.0.1
TELEMETRY_RUNTIME_ADAPTER_SNMP_OID=1.3.6.1.2.1.1.3.0
TELEMETRY_RUNTIME_ADAPTER_SNMP_SAMPLE_KEY=nanfo-snmp-runtime
TELEMETRY_RUNTIME_ADAPTER_SNMP_METRIC=runtime_adapter_snmp_poll_latency_ms
TELEMETRY_RUNTIME_ADAPTER_SNMP_VALUE=1.0
TELEMETRY_RUNTIME_ADAPTER_SNMP_UNIT=ms
TELEMETRY_RUNTIME_ADAPTER_SNMP_SOURCE=runtime_snmp
TELEMETRY_RUNTIME_ADAPTER_GRPC_ENDPOINT=localhost:50051
TELEMETRY_RUNTIME_ADAPTER_GRPC_METHOD=TelemetryService/Poll
TELEMETRY_RUNTIME_ADAPTER_GRPC_SAMPLE_KEY=nanfo-grpc-runtime
TELEMETRY_RUNTIME_ADAPTER_GRPC_METRIC=runtime_adapter_grpc_poll_latency_ms
TELEMETRY_RUNTIME_ADAPTER_GRPC_VALUE=1.0
TELEMETRY_RUNTIME_ADAPTER_GRPC_UNIT=ms
TELEMETRY_RUNTIME_ADAPTER_GRPC_SOURCE=runtime_grpc

# ── Emulation observation and manual lab controls (ADR-009/ADR-010) ─────────
# For measured observation also set EXECUTION_MODE=emulation and PYTHONPATH=..:.
# The binding must be outside the producer output directory and operator-owned.
EMULATION_SNAPSHOT_PATH=
EMULATION_BINDING_PATH=
EMULATION_SNAPSHOT_MAX_BYTES=4194304
EMULATION_SNAPSHOT_MAX_AGE_SECONDS=30
EMULATION_SNAPSHOT_FUTURE_SKEW_SECONDS=2
# Manual lab controls stay disabled unless explicitly approved and configured.
# Paths must be absolute, separate operator-provisioned directories. Never give
# the API/worker Docker or root access. See app/modules/intent/README.md.
EMULATION_CONTROL_ENABLED=false
EMULATION_COMMANDS_PATH=
EMULATION_RESULTS_PATH=
EMULATION_EXECUTION_TIMEOUT_SECONDS=120
EMULATION_EXECUTION_LEASE_SECONDS=15
EMULATION_EXECUTION_POLL_SECONDS=1
EMULATION_CONTROL_MAX_BYTES=1048576

# ── Plugin runtime safety baseline ───────────────────────────────────────────
PLUGIN_PLATFORM_VERSION=0.1.0
PLUGIN_TRUSTED_SIGNERS=nanfo-labs,partner-signed
PLUGIN_SIGNATURE_PREFIX=sig:
PLUGIN_SIGNATURE_MIN_LENGTH=16
PLUGIN_MAX_DEPENDENCY_COUNT=25
PLUGIN_ALLOWED_ISOLATION_MODES=process,container
PLUGIN_ALLOWED_PERMISSIONS=read:telemetry,read:topology,read:alerts
# plugin.failed events: one per (actor, key, code) per window, capped per actor.
PLUGIN_FAILED_EVENT_WINDOW_SECONDS=60
PLUGIN_FAILED_EVENT_MAX_PER_ACTOR=10

# ── Reports ──────────────────────────────────────────────────────────────────
# Provision externally, owned by the backend service UID, mode 0700.
# Never expose this directory through a static web server.
REPORTS_STORAGE_PATH=/var/lib/nanfo/reports
REPORTS_MAX_BYTES=8388608
REPORTS_MIN_FREE_BYTES=67108864
REPORTS_LEASE_SECONDS=120
# Claims without committed progress before terminal failed/attempts_exhausted (C20).
REPORTS_MAX_CLAIM_ATTEMPTS=5
# Generated-report expiry in days; 0 keeps reports forever (opt-in retention).
REPORTS_RETENTION_DAYS=0
# Per-organisation stored-report budget (C26); must be >= REPORTS_MAX_BYTES.
REPORTS_MAX_BYTES_PER_ORG=536870912
REPORTS_ORPHAN_GRACE_SECONDS=86400
REPORTS_MAINTENANCE_INTERVAL_SECONDS=3600

# ── Workflow governance (constitution §2, C3/C18/C20) ────────────────────────
# Four-eyes rule: the approving (executing) user must differ from the requester.
INTENT_REQUIRE_DISTINCT_APPROVER=true
SIMULATION_MAX_CLAIM_ATTEMPTS=5
SIMULATION_MAX_ACTIVE_PER_WORKSPACE=8
# Server policy floors; execution evidence limits may be stricter, never weaker.
SIMULATION_POLICY_MAX_LOSS_PCT=1.0
SIMULATION_POLICY_MAX_LATENCY_MS=1000
SIMULATION_POLICY_MIN_THROUGHPUT_MBPS=0

# ── Autonomy governance (C25) ────────────────────────────────────────────────
AUTONOMY_REQUIRE_DISTINCT_APPROVER=true
AUTONOMY_STOP_ALLOW_READ_ONLY=true
AUTONOMY_DECISION_RETENTION_DAYS=30
# C26 tenant fairness: concurrent frozen-model diagnostics per organisation (1-16).
AUTONOMY_MODEL_DIAGNOSTICS_MAX_PER_ORG=2
# Experimental lab surfaces (C17 allow_uncalibrated_confidence) are opt-in only.
NANFO_EXPERIMENTAL_LAB_ENABLED=false

# ── Retention of published outbox rows and alert observations (days) ────────
# Applied in bounded batches by the owning worker. 0 disables deletion (keep forever).
NETWORK_OUTBOX_RETENTION_DAYS=30
REPORT_OUTBOX_RETENTION_DAYS=30
SIMULATION_OUTBOX_RETENTION_DAYS=30
INTENT_OUTBOX_RETENTION_DAYS=30
ALERT_OBSERVATION_RETENTION_DAYS=30
# Alert observation purge: rows per batch, batches per run, minimum seconds between runs.
ALERT_OBSERVATION_PURGE_BATCH_SIZE=1000
ALERT_OBSERVATION_PURGE_MAX_BATCHES=10
ALERT_OBSERVATION_PURGE_INTERVAL_SECONDS=300
