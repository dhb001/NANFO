# NANFO Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
# demo enables synthetic adapters; emulation/production require installed real adapters.
# Selecting a mode does not install a controller, evaluator, or report renderer.
EXECUTION_MODE=demo
LOG_LEVEL=INFO
# Comma-separated allowed browser origins for API CORS preflight/requests
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nanfo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=nanfo

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max failed login attempts per IP before temporary lockout
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ── Runtime Telemetry Adapter ─────────────────────────────────────────────────
# Modes: stub, seeded, snmp, grpc
TELEMETRY_RUNTIME_ADAPTER_MODE=stub
TELEMETRY_RUNTIME_ADAPTER_SEEDED_SAMPLE_KEY=nanfo-runtime
TELEMETRY_RUNTIME_ADAPTER_SEEDED_METRIC=runtime_adapter_heartbeat
TELEMETRY_RUNTIME_ADAPTER_SEEDED_VALUE=1.0
TELEMETRY_RUNTIME_ADAPTER_SEEDED_UNIT=count
TELEMETRY_RUNTIME_ADAPTER_SEEDED_SOURCE=runtime_seeded
TELEMETRY_RUNTIME_ADAPTER_SNMP_TARGET=127.0.0.1
TELEMETRY_RUNTIME_ADAPTER_SNMP_OID=1.3.6.1.2.1.1.3.0
TELEMETRY_RUNTIME_ADAPTER_SNMP_SAMPLE_KEY=nanfo-snmp-runtime
TELEMETRY_RUNTIME_ADAPTER_SNMP_METRIC=runtime_adapter_snmp_poll_latency_ms
TELEMETRY_RUNTIME_ADAPTER_SNMP_VALUE=1.0
TELEMETRY_RUNTIME_ADAPTER_SNMP_UNIT=ms
TELEMETRY_RUNTIME_ADAPTER_SNMP_SOURCE=runtime_snmp
TELEMETRY_RUNTIME_ADAPTER_GRPC_ENDPOINT=localhost:50051
TELEMETRY_RUNTIME_ADAPTER_GRPC_METHOD=TelemetryService/Poll
TELEMETRY_RUNTIME_ADAPTER_GRPC_SAMPLE_KEY=nanfo-grpc-runtime
TELEMETRY_RUNTIME_ADAPTER_GRPC_METRIC=runtime_adapter_grpc_poll_latency_ms
TELEMETRY_RUNTIME_ADAPTER_GRPC_VALUE=1.0
TELEMETRY_RUNTIME_ADAPTER_GRPC_UNIT=ms
TELEMETRY_RUNTIME_ADAPTER_GRPC_SOURCE=runtime_grpc
