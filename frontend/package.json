{
  "name": "nanfo-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Dhruvin Hitesh Bhudia <dhruvinbhudiael11@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tests/fullstack/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf:bundle": "vite build --mode production && node --experimental-strip-types ./scripts/perf/check-bundle-continuity.ts",
    "api:types": "node --experimental-strip-types ./scripts/openapi/generate-types.ts",
    "api:check": "node --experimental-strip-types ./scripts/openapi/generate-types.ts --check"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^25.0.1",
    "openapi-typescript": "7.13.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
