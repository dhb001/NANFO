# Frontend build/runtime configuration (ADR-028 C16).
#
# Production / gateway builds: leave both variables UNSET. The UI then calls the
# API on its own origin ("") and derives ws:// or wss:// from window.location.
# `vite build` refuses loopback values (localhost/127.0.0.0/8/::1) so a packaged
# bundle can never be pinned to a developer machine.
#
# Local development: `npm run dev` proxies same-origin /api and /ws to
# NANFO_DEV_API_PROXY_TARGET (default http://127.0.0.1:8000; empty disables).
# To call a backend cross-origin instead, put overrides in .env.development.local:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#   VITE_WS_BASE_URL=ws://127.0.0.1:8000
#
# Owned local runners that must build against a loopback API may opt in with the
# build-process variable NANFO_ALLOW_LOOPBACK_API_BASE_URL=1 (never exposed to code).
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
